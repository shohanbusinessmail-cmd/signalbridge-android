<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.signalbridge.app">

    <!--
      SignalBridge does not require internet access for its core operation.
      The INTERNET permission is intentionally NOT declared.
      Network-dependent behavior (operator USSD/MMI via the system dialer) is
      handled by the carrier network and the platform dialer, not by this app.
    -->

    <uses-permission android:name="android.permission.READ_PHONE_STATE"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.READ_PHONE_NUMBERS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Telephony hardware is optional; the app gracefully degrades on Wi-Fi-only devices. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <application
        android:name=".app.SignalBridgeApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:monochromeIcon="@mipmap/ic_launcher_monochrome"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@theme/AppTheme"
        android:windowSoftInputMode="adjustResize">

        <activity
            android:name=".app.MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@theme/AppTheme"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Boot recovery: minimal work only, no direct telephony commands. -->
        <receiver
            android:name=".telephony.BootRecoveryReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Subscription change handling. -->
        <receiver
            android:name=".telephony.SubscriptionChangeReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.telephony.action.DEFAULT_SUBSCRIPTION_CHANGED" />
                <action android:name="android.telephony.action.SUBSCRIPTION_INFO_RECORDS_UPDATED" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup" />
        </provider>

    </application>

</manifest>
